# คัดลอกเป็น .env แล้วกรอกค่าของคุณเอง (ห้ามแชร์หรืออัปโหลด .env)
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# ใช้เฉพาะรัน upload.py บนเครื่องตัวเอง ห้ามใช้บนเว็บที่เผยแพร่
SUPABASE_SERVICE_KEY=

# ตัวเลือกเพิ่มเติม
# ถ้าจะเปลี่ยนรุ่น ระบุชื่อโมเดลที่เปิดใช้กับ API key นี้ได้; ค่าเริ่มต้นคือ gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
# IMAGE_MODE=ask
# DEBUG=1
